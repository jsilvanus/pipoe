# Copy to .env (read from the working directory at startup) or point PIPOE_ENV_FILE at another file.
# Real environment variables override the file.
# Server
PIPOE_PORT=3108
PIPOE_HOST=0.0.0.0
PIPOE_MODE=simulation # simulation | production
# Optional bearer token required on every /api request (recommended: this service switches power)
# PIPOE_API_KEY=

# PLANET GS-4210-16P2S (production mode)
# Switch address. Factory default 192.168.0.100; moves to 192.168.1.2 on Wednesday (2026-11-04).
PIPOE_SWITCH_HOST=192.168.0.100
PIPOE_SNMP_COMMUNITY=public
# Write community; defaults to PIPOE_SNMP_COMMUNITY. Needed for on/off/cycle.
# PIPOE_SNMP_WRITE_COMMUNITY=private
PIPOE_SNMP_PORT=161
PIPOE_SNMP_TIMEOUT_MS=3000

# Switch layout
PIPOE_POE_PORTS=16
PIPOE_PSE_GROUP=1
# Friendly names (name=port, comma separated). Only named ports can be switched.
PIPOE_PORT_NAMES=cam1=1,cam2=2
# PIPOE_ALLOW_UNLISTED=0

# Optional per-port power (unverified for this switch model): OID prefix, the port number is appended.
# PIPOE_SNMP_PORT_POWER_OID=
# PIPOE_SNMP_PORT_POWER_SCALE=0.001
