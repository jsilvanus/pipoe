{
  "name": "pipoe",
  "version": "0.1.0",
  "description": "PoE switch controller service and CLI (PLANET SGS-4210 via SNMP) in the Raspberry Pi production ecosystem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "bin": {
    "pipoe": "bin/pipoe.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "net-snmp": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin",
    "openapi"
  ]
}
